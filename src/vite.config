  plugins: [
    react(),
    VitePWA({
      registerType: 'autoUpdate',
      strategies: 'injectManifest',
      srcDir: 'src',
      filename: 'sw.ts',
      injectManifest: {
        globPatterns: ['**/*.{js,css,html,ico,png,svg,woff2}'],
      },
      includeAssets: ['favicon.png', 'apple-touch-icon.png', 'icon-192.png'],
      manifest: {
        name: 'QuiChat',
        short_name: 'QuiChat',
        description: 'A sleek, real-time messaging app with end-to-end encryption aesthetics.',
        theme_color: '#0f172a',
        background_color: '#0f172a',
